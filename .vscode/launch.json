{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug wave",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/Debug/wave",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreAllErrors": true
                }
            ],
            "preLaunchTask": "CMake: build"
        }
    ]
}